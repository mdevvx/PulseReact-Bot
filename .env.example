# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Your Discord user ID, used to restrict kick!sync to you only
OWNER_ID=

# Supabase project credentials
SUPABASE_URL=
SUPABASE_KEY=
# Postgres schema holding the bot's tables (default: pulsereact)
SUPABASE_SCHEMA=pulsereact

# Only needed for the one-off migration: python -m scripts.migrate_data
OLD_SUPABASE_URL=
OLD_SUPABASE_KEY=
NEW_SUPABASE_URL=
NEW_SUPABASE_KEY=
